# === Database ===
DATABASE_URL=postgresql://thinktls:changeme@localhost:5432/thinktls_bid_desk

# === JWT Auth ===
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-in-production-use-256-bit-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# === Anthropic (AI matching + NL query) ===
ANTHROPIC_API_KEY=sk-ant-...

# === SendGrid (email invitations + inbound parse) ===
SENDGRID_API_KEY=SG....
SENDGRID_FROM_EMAIL=noreply@thinktls.com
FROM_EMAIL=bids@thinktls.com
FROM_NAME=ThinkTLS Bid Desk
# Secret for validating inbound parse webhook signatures
SENDGRID_WEBHOOK_KEY=

# === Razor ERP ===
RAZOR_BASE_URL=https://erp.yourdomain.com/api
RAZOR_API_KEY=

# Set to "true" to auto-push approved deals to Razor without manual click
AUTO_PUSH_RAZOR=false

# === Frontend ===
FRONTEND_URL=http://localhost:3000

# === Fluff engine default (%) ===
FLUFF_PERCENTAGE=3.5

# === Seed admin credentials ===
ADMIN_EMAIL=admin@thinktls.com
ADMIN_PASSWORD=changeme123
